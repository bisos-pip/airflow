""" #+begin_org
* Panel::  [[file:/bisos/panels/bisos-apps/NameOfThePanelComeHere/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers

Airflow 3 moved DAG-file parsing out of the scheduler into a standalone
dag-processor process. Without this unit the scheduler starts cleanly, the
api-server serves, and the metadata DB migrates --- but no DAG file is ever
parsed into the DB, so `airflow dags list` stays empty and nothing can run.
That failure is silent: every other unit looks healthy.

This unit did not exist while the package targeted the Airflow 2 process set
(db / webserver / scheduler / triggerer).
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

from bisos.basics import pathPlus

def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""

    if ( execPath := pathPlus.whichBinPath("airflow",)
    ) is None: return None

    templateStr = f"""
[Unit]
Description=Airflow DAG Processor
After=network.target airflow-db.service
Requires=airflow-db.service

[Service]
User=airflow
Group=airflow
EnvironmentFile=/etc/default/airflow
ExecStart={execPath} dag-processor
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr

systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="airflow-dag-processor",
    sysdUnitFileFunc=sysdUnitFileFunc,
)
